<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4325.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT d.Mes,&#xa;           SUM(dbo.fn_PortfolioDailyReturn(@PortfolioId, d.Dia)) AS RetornoMes,&#xa;           (SELECT SUM(p.PnL)&#xa;            FROM dbo.PositionDaily p&#xa;            WHERE p.PortfolioId = @PortfolioId&#xa;              AND YEAR(p.AsOfDate) = @Year&#xa;              AND MONTH(p.AsOfDate) = d.Mes)                      AS PnLMes&#xa;    FROM (SELECT DISTINCT CONVERT(DATE, AsOfDate) AS Dia,&#xa;                          MONTH(AsOfDate)         AS Mes&#xa;          FROM dbo.PositionDaily&#xa;          WHERE PortfolioId = @PortfolioId&#xa;            AND YEAR(AsOfDate) = @Year) d&#xa;    GROUP BY d.Mes&#xa;    ORDER BY d.Mes" StatementId="1" StatementCompId="6" StatementType="SELECT" StatementSqlHandle="0x090035A70EC4A252C028E73E38150F5F4F440000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="1013578649" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="443.772" StatementEstRows="12" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xCEE1FA8AF219367B" QueryPlanHash="0x9ABBB46A4844A1A4" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="false" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="10" MemoryGrant="47200" CachedPlanSize="128" CompileTime="851" CompileCPU="851" CompileMemory="1576" ContainsInlineScalarTsqlUdfs="1"><ThreadStat Branches="2" UsedThreads="30"><ThreadReservation NodeId="0" ReservedThreads="10"></ThreadReservation><ThreadReservation NodeId="1" ReservedThreads="10"></ThreadReservation></ThreadStat><Warnings><PlanAffectingConvert ConvertIssue="Cardinality Estimate" Expression="CONVERT(varchar(10),[Fi